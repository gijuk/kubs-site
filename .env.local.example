# 이 파일을 복사해서 .env.local 로 저장한 뒤 실제 값을 채워 넣으세요.
# .env.local은 git에 커밋하지 마세요 (.gitignore에 이미 포함되어 있습니다).

# Supabase 대시보드 → Project Settings → API 에서 확인 가능
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# /admin 로그인 비밀번호 (원하는 값으로 자유롭게 설정)
ADMIN_PASSWORD=change-me-please

# 일정 알림(D-1 이메일) 발송용 Resend — https://resend.com 대시보드 → API Keys 에서 발급
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# 발신자 주소. 도메인 인증 전에는 Resend 기본 발신 주소(onboarding@resend.dev)만 사용 가능합니다.
REMINDER_FROM_EMAIL="KUBS, in one place <onboarding@resend.dev>"
# Vercel Cron이 /api/reminders 를 호출할 때 쓰는 비밀값 (Vercel 프로젝트 환경변수에도 동일하게 설정)
CRON_SECRET=change-me-too
